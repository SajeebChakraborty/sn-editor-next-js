# Environment template for SN Editor

# MongoDB Atlas (optional — without it, users/plans are stored in apps/web/data/sn-editor.json)
MONGODB_URI=

# AWS
AWS_REGION=us-east-1
S3_BUCKET=sn-editor-dev-assets

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Auth cookie signing (change in production)
AUTH_SECRET=sn-editor-dev-auth-secret-change-in-production

# Stripe keys can also be set from the Admin panel. Env values are fallbacks.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Feature flags (optional overrides)
# SN_EDITOR_FF_AI_IMAGE_TOOLS=true
# SN_EDITOR_FF_TEMPORAL_WORKFLOWS=false
